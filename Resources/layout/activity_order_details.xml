<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <TextView
        android:id="@+id/txtOrderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تفاصيل الطلب"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_ripple"
        android:padding="18dp">

      <TextView
          android:id="@+id/txtCustomer"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text=""
          android:textSize="15sp"
          android:textColor="@color/black" />

      <TextView
          android:id="@+id/txtFrom"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text=""
          android:textSize="14sp"
          android:textColor="@color/text_secondary"
          android:layout_marginTop="10dp" />

      <TextView
          android:id="@+id/txtTo"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text=""
          android:textSize="14sp"
          android:textColor="@color/text_secondary"
          android:layout_marginTop="6dp" />

      <TextView
          android:id="@+id/txtNote"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text=""
          android:textSize="14sp"
          android:textColor="@color/text_secondary"
          android:layout_marginTop="6dp" />

      <TextView
          android:id="@+id/txtStatus"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/accent"
          android:layout_marginTop="14dp" />

      <TextView
          android:id="@+id/txtPin"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:textSize="19sp"
          android:textStyle="bold"
          android:textColor="@color/accent"
          android:padding="10dp"
          android:background="@drawable/edit_rounded"
          android:layout_marginTop="8dp" />

      <TextView
          android:id="@+id/txtFare"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:textSize="18sp"
          android:textStyle="bold"
          android:textColor="@color/black"
          android:layout_marginTop="6dp" />

      <LinearLayout
          android:id="@+id/linerDriverActions"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="قبول الطلب والذهاب"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_accept"
            android:drawableTint="@color/white"
            android:drawablePadding="8dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/tile_orange_selector" />

        <Button
            android:id="@+id/btnArrive"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="وصلت إلى العميل"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_arrive"
            android:drawablePadding="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tile_card_selector" />

        <Button
            android:id="@+id/btnStartRide"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="انطلقت الرحلة"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_start"
            android:drawablePadding="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tile_card_selector" />

        <Button
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="إنهاء الطلب (وصلت الوجهة)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_finish"
            android:drawableTint="@color/white"
            android:drawablePadding="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tile_orange_selector" />

        <Button
            android:id="@+id/btnReject"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="رفض الطلب"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_close"
            android:drawableTint="@color/white"
            android:drawablePadding="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tile_red_selector" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/arrivalActions"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="10dp"
          android:visibility="gone">

        <Button
            android:id="@+id/btnCustomerArrived"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="السائق وصل"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_check"
            android:drawableTint="@color/white"
            android:drawablePadding="8dp"
            android:background="@drawable/tile_green_selector"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btnCustomerNotArrived"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="لم يصل"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_warning"
            android:drawableTint="@color/white"
            android:drawablePadding="8dp"
            android:background="@drawable/tile_red_selector"
            android:layout_marginStart="5dp" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnOpenOrderMap"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="عرض على الخريطة"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_map"
            android:drawablePadding="6dp"
            android:background="@drawable/tile_card_selector"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btnDriverLocation"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="موقع السائق"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_arrive"
            android:drawableTint="@color/white"
            android:drawablePadding="6dp"
            android:background="@drawable/tile_orange_selector"
            android:layout_marginStart="5dp" />
      </LinearLayout>

      <Button
          android:id="@+id/btnTrack"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="تتبع الطلب مباشرة"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:gravity="center"
          android:drawableStart="@drawable/ic_action_track"
          android:drawableTint="@color/white"
          android:drawablePadding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/tile_orange_selector" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnChat"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="محادثة"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_chat"
            android:drawablePadding="6dp"
            android:background="@drawable/tile_card_selector"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="اتصال"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:drawableStart="@drawable/ic_action_call"
            android:drawablePadding="6dp"
            android:background="@drawable/tile_card_selector"
            android:layout_marginStart="5dp" />
      </LinearLayout>

      <Button
          android:id="@+id/btnRate"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="تقييم الرحلة"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:gravity="center"
          android:drawableStart="@drawable/ic_action_rate"
          android:drawableTint="@color/white"
          android:drawablePadding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/tile_orange_selector" />

      <Button
          android:id="@+id/btnShareReceipt"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="مشاركة الإيصال"
          android:textSize="15sp"
          android:textColor="@color/text_primary"
          android:gravity="center"
          android:drawableStart="@drawable/ic_action_receipt"
          android:drawablePadding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/tile_card_selector" />

      <Button
          android:id="@+id/btnReorder"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="إعادة الطلب"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/text_primary"
          android:gravity="center"
          android:drawableStart="@drawable/ic_action_reorder"
          android:drawablePadding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/tile_card_selector" />

      <Button
          android:id="@+id/btnFavDriver"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="إضافة السائق للمفضلة"
          android:textSize="15sp"
          android:textColor="@color/text_primary"
          android:gravity="center"
          android:drawableStart="@drawable/ic_action_heart"
          android:drawablePadding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/tile_card_selector" />

      <Button
          android:id="@+id/btnBlockDriver"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="حظر هذا السائق"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:gravity="center"
          android:drawableStart="@drawable/ic_action_block"
          android:drawableTint="@color/white"
          android:drawablePadding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/tile_red_selector" />

      <Button
          android:id="@+id/btnCancel"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="إلغاء الطلب"
          android:textSize="15sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:gravity="center"
          android:drawableStart="@drawable/ic_action_close"
          android:drawableTint="@color/white"
          android:drawablePadding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/tile_red_selector" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/red"
        android:gravity="center"
        android:layout_marginTop="10dp" />
  </LinearLayout>
</ScrollView>
