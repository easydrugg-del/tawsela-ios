<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ملفي الشخصي"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:id="@+id/cardLoyalty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_ripple"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="نقاط الولاء والعضوية"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/primary" />

      <TextView
          android:id="@+id/txtLoyalty"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textSize="15sp"
          android:textColor="@color/text_secondary"
          android:layout_marginTop="8dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="اسم المستخدم"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/txtUserName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:enabled="false"
        android:textSize="15sp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/edit_rounded"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الاسم الكامل"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <EditText
        android:id="@+id/txtFullName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textSize="15sp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/edit_rounded"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="رقم الهاتف"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="14dp" />

    <EditText
        android:id="@+id/txtPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:inputType="phone"
        android:textSize="15sp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/edit_rounded"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="حفظ التغييرات"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="16dp"
        android:background="@drawable/tile_orange_selector" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تغيير كلمة المرور"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/txtOldPwd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="كلمة المرور الحالية"
        android:textSize="15sp"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/edit_rounded" />

    <EditText
        android:id="@+id/txtNewPwd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="كلمة المرور الجديدة"
        android:textSize="15sp"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/edit_rounded"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/txtNewPwd2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="تأكيد كلمة المرور الجديدة"
        android:textSize="15sp"
        android:inputType="textPassword"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:background="@drawable/edit_rounded"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnChangePwd"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="تغيير كلمة المرور"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="16dp"
        android:background="@drawable/tile_card_selector" />

    <Button
        android:id="@+id/btnAdminAccounts"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="إدارة حسابات المدير"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_card_selector"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnDeleteAccount"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="حذف حسابي نهائياً"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="12dp"
        android:background="@drawable/tile_red_selector"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtDeleteWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="أو اطلب حذف الحساب عبر صفحة الويب"
        android:textSize="13sp"
        android:textColor="@color/primary"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/red"
        android:gravity="center"
        android:layout_marginTop="12dp" />
  </LinearLayout>
</ScrollView>
