<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🗑️ العملاء المحذوفون"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="أرشيف بيانات العملاء المحذوفين ومن حذفها ومتى"
        android:textSize="13sp"
        android:textColor="#DDDDDD"
        android:layout_marginTop="4dp" />
  </LinearLayout>

  <TextView
      android:id="@+id/txtDeletedEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="لا يوجد محذوفون بعد"
      android:textSize="14sp"
      android:textColor="@color/gray"
      android:gravity="center"
      android:padding="20dp" />

  <ListView
      android:id="@+id/lstDeleted"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@null"
      android:dividerHeight="0dp" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Designed @ Ahmed Ali"
      android:textSize="10sp"
      android:textColor="@color/text_secondary"
      android:gravity="center"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:alpha="0.6" />
</LinearLayout>
