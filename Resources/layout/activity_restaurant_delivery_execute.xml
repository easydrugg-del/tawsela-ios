<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تنفيذ توصيل المطعم"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الحالة: —"
        android:textSize="13sp"
        android:textColor="#ccffffff"
        android:layout_marginTop="4dp" />
  </LinearLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <TextView
          android:id="@+id/txtRestName"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="المطعم: —"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/text_primary"
          android:layout_marginBottom="12dp" />

      <TextView
          android:id="@+id/txtPickup"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="نقطة الاستلام: —"
          android:textSize="14sp"
          android:textColor="@color/text_secondary"
          android:layout_marginBottom="8dp" />

      <TextView
          android:id="@+id/txtDelivery"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="نقطة التسليم: —"
          android:textSize="14sp"
          android:textColor="@color/text_secondary"
          android:layout_marginBottom="16dp" />

      <TextView
          android:id="@+id/txtFare"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="سعر التوصيل: — ج.م"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/primary"
          android:layout_marginBottom="20dp" />

      <!-- أزرار التنفيذ حسب الحالة -->
      <Button
          android:id="@+id/btnAcceptDelivery"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="قبول التوصيل"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:background="@drawable/tile_orange_selector"
          android:layout_marginBottom="8dp"
          android:visibility="gone" />

      <Button
          android:id="@+id/btnArrivedAtRestaurant"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="وصلت للمحل"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:background="@drawable/tile_blue_selector"
          android:layout_marginBottom="8dp"
          android:visibility="gone" />

      <Button
          android:id="@+id/btnPickedUp"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="استلمت الطلب"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:background="@drawable/tile_blue_selector"
          android:layout_marginBottom="8dp"
          android:visibility="gone" />

      <Button
          android:id="@+id/btnDeliveredToCustomer"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="وصلت للعميل"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:background="@drawable/tile_green_selector"
          android:layout_marginBottom="8dp"
          android:visibility="gone" />

      <Button
          android:id="@+id/btnCompleteDelivery"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:text="إنهاء التوصيل"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:background="@drawable/tile_green_selector"
          android:layout_marginBottom="20dp"
          android:visibility="gone" />


    </LinearLayout>
  </ScrollView>

</LinearLayout>
