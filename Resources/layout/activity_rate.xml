<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/surface"
    android:padding="24dp">

  <TextView
      android:id="@+id/txtRateTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="قيّم تجربتك"
      android:textSize="22sp"
      android:textStyle="bold"
      android:textColor="@color/primary" />

  <TextView
      android:id="@+id/txtRateSub"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text=""
      android:textSize="14sp"
      android:textColor="@color/text_secondary"
      android:layout_marginTop="6dp" />

  <LinearLayout
      android:id="@+id/starRow"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginTop="20dp" />

  <LinearLayout
      android:id="@+id/tagRow"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center"
      android:layout_marginTop="12dp" />

  <Button
      android:id="@+id/btnPickPhoto"
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:text="إضافة صورة (اختياري)"
      android:textColor="@color/white"
      android:background="@drawable/tile_orange_selector"
      android:layout_marginTop="10dp" />

  <ImageView
      android:id="@+id/imgPreview"
      android:layout_width="120dp"
      android:layout_height="120dp"
      android:visibility="gone"
      android:layout_gravity="center"
      android:layout_marginTop="8dp" />

  <EditText
      android:id="@+id/txtComment"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:hint="أضف تعليق (اختياري)"
      android:minLines="3"
      android:gravity="top"
      android:background="@drawable/edit_rounded"
      android:padding="14dp"
      android:layout_marginTop="12dp" />

  <Button
      android:id="@+id/btnSubmitRate"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="إرسال التقييم"
      android:background="@drawable/tile_orange_selector"
      android:textColor="@color/white"
      android:layout_marginTop="20dp" />
</LinearLayout>
