<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إدارة أنواع الخدمة"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/card_ripple"
      android:padding="12dp"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌙 فترة الليل (بالساعة)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="2">

      <Spinner
          android:id="@+id/spnNightFrom"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="wrap_content" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="إلى"
          android:textSize="14sp"
          android:paddingLeft="8dp"
          android:paddingRight="8dp" />

      <Spinner
          android:id="@+id/spnNightTo"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSaveNight"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="حفظ فترة الليل"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_marginTop="8dp"
        android:background="@drawable/tile_orange_selector" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:weightSum="2"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp">

    <Button
        android:id="@+id/btnShowDay"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="46dp"
        android:text="☀️ أسعار النهار"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginEnd="4dp"
        android:background="@drawable/tile_card_selector" />

    <Button
        android:id="@+id/btnShowNight"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="46dp"
        android:text="🌙 أسعار الليل"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:layout_marginStart="4dp"
        android:background="@drawable/tile_card_selector" />
  </LinearLayout>

  <Button
      android:id="@+id/btnAddService"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:text="إضافة نوع خدمة"
      android:textSize="15sp"
      android:textColor="@color/white"
      android:background="@drawable/tile_orange_selector"
      android:layout_margin="16dp" />

  <ListView
      android:id="@+id/lstServices"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@null"
      android:dividerHeight="0dp" />
</LinearLayout>
