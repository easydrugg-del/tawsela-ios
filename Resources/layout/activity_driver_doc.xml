<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إعادة إرسال الوثائق"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/txtDocStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/edit_rounded"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="صورة الفاتورة"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
      <Button
          android:id="@+id/btnDocBill"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="48dp"
          android:text="اختيار صورة الفاتورة"
          android:textColor="@color/text_primary"
          android:background="@drawable/tile_card_selector" />
      <TextView
          android:id="@+id/txtDocBillStatus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="لم تُرفع"
          android:textSize="13sp"
          android:paddingStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ترخيص المرور"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
      <Button
          android:id="@+id/btnDocTraffic"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="48dp"
          android:text="اختيار صورة الترخيص"
          android:textColor="@color/text_primary"
          android:background="@drawable/tile_card_selector" />
      <TextView
          android:id="@+id/txtDocTrafficStatus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="لم تُرفع"
          android:textSize="13sp"
          android:paddingStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بطاقة السائق"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
      <Button
          android:id="@+id/btnDocDriverCard"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="48dp"
          android:text="اختيار صورة البطاقة"
          android:textColor="@color/text_primary"
          android:background="@drawable/tile_card_selector" />
      <TextView
          android:id="@+id/txtDocDriverCardStatus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="لم تُرفع"
          android:textSize="13sp"
          android:paddingStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بطاقة المالك"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
      <Button
          android:id="@+id/btnDocOwnerCard"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="48dp"
          android:text="اختيار صورة بطاقة المالك"
          android:textColor="@color/text_primary"
          android:background="@drawable/tile_card_selector" />
      <TextView
          android:id="@+id/txtDocOwnerCardStatus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="لم تُرفع"
          android:textSize="13sp"
          android:paddingStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="أصل الفيش"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
      <Button
          android:id="@+id/btnDocReceipt"
          android:layout_width="0dp"
          android:layout_weight="1"
          android:layout_height="48dp"
          android:text="اختيار صورة الفيش"
          android:textColor="@color/text_primary"
          android:background="@drawable/tile_card_selector" />
      <TextView
          android:id="@+id/txtDocReceiptStatus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="لم تُرفع"
          android:textSize="13sp"
          android:paddingStart="10dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="رقم التشغيل"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="12dp" />
    <EditText
        android:id="@+id/txtDocOpLicense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="رقم التشغيل"
        android:background="@drawable/edit_rounded"
        android:padding="12dp"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnSendDoc"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="إرسال للمراجعة"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/tile_orange_selector"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />
  </LinearLayout>
</ScrollView>
