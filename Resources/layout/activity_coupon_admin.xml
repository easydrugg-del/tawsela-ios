<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إدارة أكواد الخصم"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />
  </LinearLayout>

  <Button
      android:id="@+id/btnAddCoupon"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:text="إضافة كوبون"
      android:textSize="15sp"
      android:textColor="@color/white"
      android:background="@drawable/tile_orange_selector"
      android:layout_margin="16dp" />

  <TextView
      android:id="@+id/txtEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="لا توجد أكواد خصم. اضغط «إضافة كوبون» لإنشاء أول كود."
      android:textSize="15sp"
      android:textColor="@color/gray"
      android:gravity="center"
      android:padding="24dp"
      android:visibility="gone" />

  <ListView
      android:id="@+id/lstCoupons"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@null"
      android:dividerHeight="0dp" />
</LinearLayout>
