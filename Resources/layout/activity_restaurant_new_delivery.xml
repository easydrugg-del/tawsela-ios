<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="طلب توصيل جديد"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />
  </LinearLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- منطقة التسعير: مخفية عن المستخدم — بتتحدد تلقائيًا في الكود وبتُستخدم عند الإرسال -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="منطقة التوصيل والسعر"
          android:textStyle="bold"
          android:textColor="@color/text_primary"
          android:visibility="gone" />
      <Spinner
          android:id="@+id/spnDeliveryArea"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginBottom="8dp"
          android:visibility="gone" />

      <TextView
          android:id="@+id/txtCalculatedFare"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="سعر التوصيل: —"
          android:textStyle="bold"
          android:textColor="@color/primary"
          android:layout_marginBottom="12dp"
          android:visibility="gone" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="عنوان الاستلام (المطعم)"
          android:textStyle="bold"
          android:textColor="@color/text_primary" />
      <EditText
          android:id="@+id/txtPickupAddress"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="عنوان المطعم"
          android:background="@drawable/edit_rounded"
          android:padding="10dp"
          android:layout_marginBottom="4dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginBottom="4dp">
        <Button
            android:id="@+id/btnPickPickup"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="📍 تحديد على الخريطة" />
        <TextView
            android:id="@+id/txtPickupCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/gray"
            android:layout_marginLeft="8dp" />
      </LinearLayout>

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="عنوان التسليم (العميل)"
          android:textStyle="bold"
          android:textColor="@color/text_primary" />
      <EditText
          android:id="@+id/txtDeliveryAddress"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="عنوان العميل"
          android:background="@drawable/edit_rounded"
          android:padding="10dp"
          android:layout_marginBottom="4dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/btnPickDelivery"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="📍 تحديد على الخريطة" />
        <TextView
            android:id="@+id/txtDeliveryCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/gray"
            android:layout_marginLeft="8dp" />
      </LinearLayout>

      <!-- اختيار سريع للوجهة: محافظة/مدينة/مناطق/شوارع -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="اختيار سريع للوجهة"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="@color/primary"
          android:layout_marginBottom="4dp" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="المحافظة"
              android:textSize="11sp"
              android:textColor="@color/text_secondary" />
          <Spinner
              android:id="@+id/spnRestGov"
              android:layout_width="match_parent"
              android:layout_height="44dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="المدينة"
              android:textSize="11sp"
              android:textColor="@color/text_secondary" />
          <Spinner
              android:id="@+id/spnRestCity"
              android:layout_width="match_parent"
              android:layout_height="44dp" />
        </LinearLayout>
      </LinearLayout>

      <TextView
          android:id="@+id/txtRestAreasLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="المناطق:"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="@color/text_secondary"
          android:layout_marginTop="10dp"
          android:layout_marginBottom="6dp" />
      <HorizontalScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:scrollbars="none"
          android:layout_marginBottom="6dp">
        <LinearLayout
            android:id="@+id/rowRestAreas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
      </HorizontalScrollView>

      <TextView
          android:id="@+id/txtRestStreetsLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="أهم الشوارع:"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="@color/text_secondary"
          android:layout_marginTop="2dp"
          android:layout_marginBottom="6dp" />

      <!-- بحث في الشوارع (نص + صوت) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginBottom="6dp">

        <EditText
            android:id="@+id/txtStreetSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ابحث عن شارع (جزء من الاسم)"
            android:inputType="text"
            android:textSize="14sp"
            android:padding="10dp"
            android:background="@drawable/edit_rounded" />

        <Button
            android:id="@+id/btnRestVoiceStreet"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text=""
            android:textSize="20sp"
            android:gravity="center"
            android:contentDescription="بحث بالصوت"
            android:drawableStart="@drawable/ic_mic"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tile_orange_selector" />
      </LinearLayout>

      <!-- شبكة الشوارع (3 في السطر) -->
      <LinearLayout
          android:id="@+id/rowRestStreetGrid"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical" />

      <EditText
          android:id="@+id/txtCustomerName"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="اسم العميل (اختياري)"
          android:background="@drawable/edit_rounded"
          android:padding="10dp"
          android:layout_marginBottom="8dp" />
      <EditText
          android:id="@+id/txtCustomerPhone"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="رقم العميل (اختياري)"
          android:inputType="phone"
          android:background="@drawable/edit_rounded"
          android:padding="10dp"
          android:layout_marginBottom="16dp" />

      <Button
          android:id="@+id/btnSubmitRestaurantDelivery"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:text="إرسال طلب التوصيل"
          android:textSize="16sp"
          android:textStyle="bold"
          android:textColor="@color/white"
          android:background="@drawable/tile_orange_selector" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
