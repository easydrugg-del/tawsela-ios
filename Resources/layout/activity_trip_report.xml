<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تقرير الرحلات خلال فترة"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/txtTripCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عدد الرحلات: —"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#DDDDDD"
        android:layout_marginTop="6dp" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="12dp"
      android:weightSum="2">

    <Button
        android:id="@+id/btnFromDate"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="48dp"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginEnd="4dp"
        android:background="@drawable/tile_card_selector" />

    <Button
        android:id="@+id/btnToDate"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="48dp"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginStart="4dp"
        android:background="@drawable/tile_card_selector" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="12dp"
      android:paddingEnd="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="التاريخ حسب:"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginEnd="8dp" />

    <Spinner
        android:id="@+id/spnDateBy"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content" />
  </LinearLayout>

  <Button
      android:id="@+id/btnShowTrips"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:text="عرض الرحلات"
      android:textSize="15sp"
      android:textStyle="bold"
      android:textColor="@color/text_primary"
      android:layout_marginStart="12dp"
      android:layout_marginEnd="12dp"
      android:background="@drawable/tile_card_selector" />

  <TextView
      android:id="@+id/txtEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="اختر الفترة ثم اضغط عرض الرحلات"
      android:textSize="14sp"
      android:textColor="@color/gray"
      android:gravity="center"
      android:padding="20dp" />

  <ListView
      android:id="@+id/lstTrips"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@null"
      android:dividerHeight="0dp" />
</LinearLayout>
