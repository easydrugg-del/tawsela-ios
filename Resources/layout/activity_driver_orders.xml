<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="التوصيلات الواردة"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />
  </LinearLayout>

  <TextView
      android:id="@+id/txtAccountStatus"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text=""
      android:textSize="14sp"
      android:textStyle="bold"
      android:textColor="@color/white"
      android:background="@color/accent"
      android:gravity="center"
      android:padding="12dp"
      android:visibility="gone" />

  <EditText
      android:id="@+id/txtSearch"
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:hint="بحث برقم الطلب أو العنوان أو الحالة"
      android:textSize="14sp"
      android:background="@drawable/edit_rounded"
      android:paddingLeft="12dp"
      android:paddingRight="12dp"
      android:layout_marginLeft="12dp"
      android:layout_marginRight="12dp"
      android:layout_marginTop="12dp" />

  <LinearLayout
      android:id="@+id/dateBar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layout_marginLeft="12dp"
      android:layout_marginRight="12dp"
      android:layout_marginTop="4dp"
      android:visibility="gone">

    <Button
        android:id="@+id/btnDateFrom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="من: —"
        android:textSize="12sp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp" />

    <Button
        android:id="@+id/btnDateTo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="إلى: —"
        android:textSize="12sp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp" />

    <Button
        android:id="@+id/btnDateClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مسح"
        android:textSize="12sp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp" />
  </LinearLayout>

  <TextView
      android:id="@+id/txtEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="لا توجد توصيلات حالياً"
      android:textSize="15sp"
      android:textColor="@color/gray"
      android:gravity="center"
      android:padding="24dp"
      android:visibility="gone" />

  <ListView
      android:id="@+id/lstOrders"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@null"
      android:dividerHeight="0dp"
      android:paddingTop="6dp"
      android:paddingBottom="6dp" />

  

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Designed @ Ahmed Ali"
      android:textSize="10sp"
      android:textColor="@color/text_secondary"
      android:gravity="center"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:alpha="0.6" />
</LinearLayout>