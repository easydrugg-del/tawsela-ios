<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/bg_header"
      android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="بيانات زر الطوارئ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="الاختيارات التي تظهر للسائق عند ضغط زر الطوارئ"
        android:textSize="13sp"
        android:textColor="#DDDDDD"
        android:layout_marginTop="4dp" />
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="12dp">

    <EditText
        android:id="@+id/txtEmType"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:hint="حالة جديدة (مثال: اختطاف)"
        android:textSize="14sp"
        android:padding="10dp"
        android:background="@drawable/edit_rounded" />

    <Button
        android:id="@+id/btnAddEmType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إضافة"
        android:textColor="@color/white"
        android:layout_marginStart="8dp"
        android:background="@drawable/tile_orange_selector" />
  </LinearLayout>

  <ListView
      android:id="@+id/lstEmTypes"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:divider="@null"
      android:dividerHeight="0dp" />

  <TextView
      android:id="@+id/txtEmTypesEmpty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="لا توجد حالات مسجلة"
      android:textSize="14sp"
      android:textColor="@color/gray"
      android:gravity="center"
      android:padding="16dp"
      android:visibility="gone" />
</LinearLayout>
