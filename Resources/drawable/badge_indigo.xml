<?xml version="1.0" encoding="utf-8"?>
<!-- أيقونة نيلية مع توهج -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-4dp" android:left="-4dp" android:right="-4dp" android:bottom="-4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:startColor="#773949AB"
                android:centerColor="#333949AB"
                android:endColor="#003949AB" />
        </shape>
    </item>
    <item android:top="3dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#CC1A237E" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="2dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#9FA8DA"
                android:centerColor="#3949AB"
                android:endColor="#283593"
                android:angle="315" />
        </shape>
    </item>
    <item android:top="3dp" android:left="7dp" android:right="7dp" android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#45FFFFFF" />
        </shape>
    </item>
</layer-list>
