<?xml version="1.0" encoding="utf-8"?>
<!-- أيقونة برتقالية مع توهج -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- التوهج الخلفي -->
    <item android:top="-4dp" android:left="-4dp" android:right="-4dp" android:bottom="-4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="24dp"
                android:startColor="#77FF7312"
                android:centerColor="#33FF7312"
                android:endColor="#00FF7312" />
        </shape>
    </item>
    <!-- الظل -->
    <item android:top="3dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#CC4A1500" />
        </shape>
    </item>
    <!-- الجسم -->
    <item android:top="0dp" android:left="0dp" android:right="2dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FF9A3C"
                android:centerColor="#FF7312"
                android:endColor="#E85300"
                android:angle="315" />
        </shape>
    </item>
    <!-- اللمعة -->
    <item android:top="3dp" android:left="7dp" android:right="7dp" android:bottom="28dp">
        <shape android:shape="oval">
            <solid android:color="#45FFFFFF" />
        </shape>
    </item>
</layer-list>
